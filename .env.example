# Optional overrides. All of these have sensible production defaults baked in,
# so the site builds and runs without this file.

# Bot-tan's biorhythm server WebSocket. Defaults to wss://bot-tan.suibari.com/ws
# in production, and ws://localhost:3000/ws during `astro dev`.
# PUBLIC_BOT_WS_URL="wss://bot-tan.suibari.com/ws"

# Follower-count history (Cloudflare Worker).
# PUBLIC_FOLLOWER_API_URL="https://bottan-measurement-worker.404-not-found-address.workers.dev/"

# Trends and the day-activity timeline, served by the biorhythm server. These
# are historical rather than live, so they are fetched over HTTP instead of
# being re-sent on every WebSocket frame.
# PUBLIC_HISTORY_API_URL="https://bot-tan.suibari.com/history"
# PUBLIC_TIMELINE_API_URL="https://bot-tan.suibari.com/timeline"

# Used only when today's recommended post came from Nagi: the AppView serves the
# author's avatar blob, and the web client owns the post permalink.
# PUBLIC_NAGI_APPVIEW_URL="https://nagi-api.suibari.com"
# PUBLIC_NAGI_WEB_URL="https://nagi.suibari.com"

# The memory graph behind /memory. Labels and aggregates only — the endpoint
# never returns conversation text or anything identifying.
# PUBLIC_MEMORY_GRAPH_API_URL="https://bot-tan.suibari.com/memory-graph"

# The biorhythm server's dev port is 3002, and its dev fallback in
# src/lib/botStatus.ts is 3000, so local runs need these four set:
#   PUBLIC_BOT_WS_URL="ws://localhost:3002/ws"
#   PUBLIC_HISTORY_API_URL="http://localhost:3002/history"
#   PUBLIC_TIMELINE_API_URL="http://localhost:3002/timeline"
#   PUBLIC_MEMORY_GRAPH_API_URL="http://localhost:3002/memory-graph"
