---
import '../styles/global.css';
import SkyBackdrop from '../components/SkyBackdrop.astro';
import Doodles from '../components/Doodles.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, localizedPath, bcp47, LOCALES, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Path within the locale, e.g. `/memory`. Defaults to the home page. */
  path?: string;
  /**
   * Set on a page that exists in one locale only. Without it the layout would
   * emit `hreflang` links to sibling URLs that were never built.
   */
  standalone?: boolean;
  /** Overrides the site-wide title/description for a subpage. */
  title?: string;
  description?: string;
}

const { lang, path = '/', standalone = false, title, description } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(localizedPath(lang, path), Astro.site).href;
const ogImage = new URL('/ogp.png', Astro.site).href;
---

<!doctype html>
<html lang={bcp47[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />

    {
      !standalone &&
        LOCALES.map((locale) => (
          <link
            rel="alternate"
            hreflang={bcp47[locale]}
            href={new URL(localizedPath(locale, path), Astro.site).href}
          />
        ))
    }
    {!standalone && <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />}

    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={bcp47[lang].replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#fdf8ef" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Yomogi&family=Zen+Kurenaido&family=DotGothic16&display=swap"
    />

    <script is:inline>
      (() => {
        const reloadKey = 'bot-tan-module-reload';

        const reloadOnce = () => {
          try {
            if (sessionStorage.getItem(reloadKey)) return;
            sessionStorage.setItem(reloadKey, '1');
          } catch {
            // Reloading without a guard could loop forever when storage is unavailable.
            return;
          }
          location.reload();
        };

        // Vite emits this when a lazy chunk from an older deployment disappears.
        window.addEventListener('vite:preloadError', (event) => {
          event.preventDefault();
          reloadOnce();
        });

        // The dashboard entry itself is referenced directly from HTML, so a
        // failed module script does not go through Vite's preload helper.
        window.addEventListener(
          'error',
          (event) => {
            const target = event.target;
            if (target instanceof HTMLScriptElement && target.type === 'module') {
              reloadOnce();
            }
          },
          true,
        );

        // A successful load re-arms recovery for a future deployment.
        window.addEventListener('load', () => sessionStorage.removeItem(reloadKey), { once: true });
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{t.nav.skipToContent}</a>

    <SkyBackdrop />
    <Doodles />

    <Header lang={lang} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />

    <script>
      /*
       * The sketch SVGs stretch to their container with preserveAspectRatio="none"
       * and vector-effect="non-scaling-stroke". That combination makes
       * stroke-dasharray resolve in *screen pixels* while the path coordinates
       * stay in viewBox units, so a build-time dash length would tile into
       * visible dashes. Measure the rendered box instead and publish the real
       * length before anything animates.
       */
      function measureSketches() {
        document.querySelectorAll<SVGSVGElement>('.sketch-frame').forEach((svg) => {
          const { width, height } = svg.getBoundingClientRect();
          if (width === 0) return;

          // Underlines are a single squiggle; frames go all the way round.
          const isRule = svg.classList.contains('sketch-heading__rule');
          const length = isRule ? width * 1.1 : (width + height) * 2 * 1.12;

          svg.style.setProperty('--sketch-length', String(Math.ceil(length)));
        });
      }

      measureSketches();
      // Webfonts land after first paint and change every box height.
      void document.fonts?.ready.then(measureSketches);

      // Frames already drawn hold stroke-dashoffset: 0, so re-measuring only
      // widens their dash pattern — it never replays the animation.
      let resizeTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(measureSketches, 200);
      });

      // One observer for the whole page. Anything with [data-reveal] fades in
      // the first time it enters the viewport, then stops being watched.
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
        );

        revealables.forEach((el) => observer.observe(el));
      } else {
        revealables.forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: 0.5rem;
        top: -4rem;
        z-index: 100;
        padding: 0.6rem 1rem;
        border-radius: 0.5rem;
        background: var(--color-paper);
        border: 2px solid var(--color-ink);
        font-family: var(--font-hand);
        color: var(--color-ink);
        text-decoration: none;
        transition: top 150ms ease;
      }

      .skip-link:focus {
        top: 0.5rem;
      }

      main {
        position: relative;
        z-index: 1;
      }
    </style>
  </body>
</html>
