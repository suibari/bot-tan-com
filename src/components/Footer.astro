---
import { Image } from 'astro:assets';
import suibariLogo from '../assets/brand/suibari-logo.png';
import { useTranslations, localizedPath, bcp47, LOCALES, langNames, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__made">{t.footer.madeBy}</p>

    <a
      class="site-footer__brand"
      href={t.footer.authorHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Image
        src={suibariLogo}
        alt={t.footer.authorName}
        widths={[240, 480]}
        sizes="15rem"
        loading="lazy"
      />
    </a>

    <div class="site-footer__thanks">
      <p class="site-footer__thanks-title">{t.footer.specialThanksTitle}</p>
      <ul class="site-footer__thanks-list">
        <li>
          {t.footer.translationProofreading}:{' '}
          <a
            href="https://github.com/loneicewolf"
            target="_blank"
            rel="noopener noreferrer"
            class="site-footer__thanks-link"
          >
            loneicewolf
          </a>
        </li>
        <li>{t.footer.supporters}</li>
      </ul>
    </div>
  </div>

  <div class="site-footer__bar">
    {
      LOCALES.filter((locale) => locale !== lang).map((locale) => (
        <a class="site-footer__link" href={localizedPath(locale)} hreflang={bcp47[locale]}>
          {langNames[locale]}
        </a>
      ))
    }
    <a class="site-footer__link" href={localizedPath(lang, '/memory')}>{t.nav.memory}</a>
    <a class="site-footer__link" href="#top">{t.footer.backToTop}</a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    margin-top: 4rem;
    padding: 2.75rem 1rem 2rem;
    color: var(--color-paper);
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, #2f3d6b 88%, transparent),
      #26315a
    );
    font-size: 0.9rem;
  }

  .site-footer__inner {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .site-footer__made {
    margin: 0 0 0.9rem;
    font-family: var(--font-hand);
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
  }

  .site-footer__brand {
    display: inline-block;
    transition: translate 180ms ease, scale 180ms ease;
  }

  .site-footer__brand:hover,
  .site-footer__brand:focus-visible {
    translate: 0 -3px;
    scale: 1.02;
  }

  .site-footer__brand :global(img) {
    width: 15rem;
    max-width: 100%;
    height: auto;
    display: block;
  }

  .site-footer__thanks {
    margin: 1.75rem 0 0;
    color: color-mix(in srgb, var(--color-paper) 80%, transparent);
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .site-footer__thanks-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-hand);
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
  }

  .site-footer__thanks-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: center;
  }

  .site-footer__thanks-link {
    color: var(--color-sky);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity 180ms ease;
  }

  .site-footer__thanks-link:hover,
  .site-footer__thanks-link:focus-visible {
    opacity: 0.8;
  }

  .site-footer__bar {
    max-width: 68rem;
    margin: 2rem auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 25%, transparent);
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .site-footer__link {
    font-family: var(--font-hand);
    color: var(--color-sky);
    text-decoration: none;
    border-bottom: 2px dashed transparent;
    transition: border-color 180ms ease;
  }

  .site-footer__link:hover,
  .site-footer__link:focus-visible {
    border-bottom-color: var(--color-sky);
  }
</style>
